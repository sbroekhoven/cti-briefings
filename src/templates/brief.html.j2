<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CTI Brief {{ date }}</title>
<style>
  body{margin:0;background:#f3f4f6;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#111827;line-height:1.5}
  .wrap{max-width:760px;margin:0 auto;padding:24px 16px}
  h1{font-size:22px;margin:0 0 4px} h2{font-size:15px;text-transform:uppercase;letter-spacing:.06em;color:#4b5563;margin:28px 0 10px}
  .meta{color:#6b7280;font-size:13px}
  .card{background:#fff;border:1px solid #e5e7eb;border-left:5px solid #9ca3af;border-radius:6px;padding:14px 16px;margin:0 0 12px}
  .card.critical{border-left-color:#b91c1c}.card.high{border-left-color:#ea580c}.card.medium{border-left-color:#ca8a04}.card.low{border-left-color:#2563eb}
  .card h3{margin:0 0 6px;font-size:16px}
  .badge{display:inline-block;font-size:11px;font-weight:600;text-transform:uppercase;padding:2px 8px;border-radius:10px;background:#e5e7eb;color:#374151;margin-right:4px}
  .badge.critical{background:#fee2e2;color:#991b1b}.badge.high{background:#ffedd5;color:#9a3412}.badge.medium{background:#fef3c7;color:#92400e}.badge.low{background:#dbeafe;color:#1e40af}
  .small{font-size:12px;color:#6b7280}
  ul{padding-left:18px;margin:0} li{margin:0 0 8px}
  a{color:#1d4ed8}
  .warn{background:#fffbeb;border:1px solid #fde68a;border-radius:6px;padding:8px 12px;font-size:12px;color:#92400e}
  .empty{color:#6b7280;font-style:italic}
  .scroll{overflow-x:auto}
  table.vulns{width:100%;border-collapse:collapse;background:#fff;border:1px solid #e5e7eb;font-size:13px}
  table.vulns th,table.vulns td{text-align:left;padding:6px 8px;border-bottom:1px solid #e5e7eb;vertical-align:top}
  table.vulns th{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:#4b5563;background:#f9fafb}
  table.vulns td.num{text-align:right;white-space:nowrap}
  .nowrap{white-space:nowrap}
</style>
</head>
<body><div class="wrap">
<h1>Cyber Threat Intelligence Brief</h1>
<div class="meta">{{ generated }} &middot; last {{ lookback }}h &middot; {{ stats.reviewed }} stories reviewed from {{ stats.sources_ok }} sources{% if dry_run %} &middot; <strong>DRY RUN PREVIEW</strong>{% endif %}</div>

<h2>Act ({{ act|length }})</h2>
{% for a in act %}
<div class="card {{ a.severity }}">
  <h3>{{ a.headline }}</h3>
  <div>
    <span class="badge {{ a.severity }}">{{ a.severity }}</span>
    <span class="badge">{{ a.action }}</span>
    {% for c in a.cves %}<span class="badge">{{ c }}</span>{% endfor %}
  </div>
  <p>{{ a.why_it_matters }}</p>
  {% if a.relevance_refs %}<div class="small">Relevance: {{ a.relevance_refs|join(', ') }}</div>{% endif %}
  {% if a.materiality_note %}<div class="small">Update: {{ a.materiality_note }}</div>{% endif %}
  <div class="small">{{ a.item.source_name }}{% if a.item.also_reported_by %} (also: {{ a.item.also_reported_by|join(', ') }}){% endif %} &middot; score {{ a.item.score }}
    &middot; {% for l in a.links %}<a href="{{ l }}">{{ 'source' if loop.first else 'link ' ~ loop.index }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</div>
</div>
{% else %}<p class="empty">Nothing requires action today.</p>{% endfor %}

<h2>Signal ({{ signal|length }})</h2>
{% if signal %}<ul>
{% for s in signal %}<li>{{ s.line }} <span class="small">(<a href="{{ s.item.link }}">{{ s.item.source_name }}</a>)</span></li>{% endfor %}
</ul>{% else %}<p class="empty">No additional signals.</p>{% endif %}

{% if vulns %}<h2>Vulnerabilities ({{ vulns|length }})</h2>
<div class="scroll"><table class="vulns">
<tr><th>CVE</th><th>Product</th><th>Description</th><th>CVSS</th><th>EPSS</th><th>Status</th><th>Source</th></tr>
{% for v in vulns %}
<tr>
  <td class="nowrap"><a href="{{ v.link }}">{{ v.cve or 'link' }}</a></td>
  <td>{{ v.product or '–' }}</td>
  <td>{{ v.description }}</td>
  <td class="num">{{ v.cvss if v.cvss is not none else '–' }}</td>
  <td class="num">{{ v.epss if v.epss is not none else '–' }}</td>
  <td>{% if v.exploited %}<span class="badge critical">exploited</span>{% endif %}{% if v.ransomware %} <span class="badge high">ransomware</span>{% endif %}{% if v.due %}<div class="small">due {{ v.due }}</div>{% endif %}</td>
  <td class="small nowrap">{{ v.source }}</td>
</tr>
{% endfor %}
</table></div>{% endif %}

{% if near_miss %}<h2>Near miss</h2>
<p><a href="{{ near_miss.link }}">{{ near_miss.title }}</a> <span class="small">({{ near_miss.source_name }})</span></p>{% endif %}

{% if warnings %}<h2>Notes</h2><div class="warn">{% for w in warnings %}{{ w }}<br>{% endfor %}</div>{% endif %}
{% if failed_sources %}<p class="small">Sources that failed this run: {{ failed_sources|join(', ') }}</p>{% endif %}
</div></body></html>
